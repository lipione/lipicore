# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lipicore
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lipicore
MESSENGER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lipicore

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_BUCKET=bank-documents
MESSENGER_UPLOAD_DIR=/tmp/lipicore_messenger_uploads

# Security
JWT_SECRET=your-super-secret-key-change-it
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM Config
# Local vLLM OpenAI-compatible endpoints. In Docker Compose these are usually
# http://lipicore-vllm-b:8000 and http://lipicore-vllm-c:8000 from the backend.
# Fast/deep model names can continue to be any deployment id used by your infra
# (for example Gemma 4/3 names). Routing keeps current behavior: route A = fast chat,
# route C = deep review.
LLM_PROVIDER=vllm
LLM_A_API_BASE=http://localhost:8002
LLM_A_MODEL=LipiFast
LLM_A_API_KEY=no-key
LLM_B_API_BASE=http://localhost:8002
LLM_B_MODEL=LipiFast
LLM_B_API_KEY=no-key
LLM_C_API_BASE=http://localhost:8003
LLM_C_MODEL=LipiCore
LLM_C_API_KEY=no-key
LLM_VISION_API_BASE=http://localhost:8007
LLM_VISION_MODEL=LipiCore
LLM_VISION_API_KEY=no-key
LLM_VISION_GPU_DEVICE=0
LLM_VISION_GPU_MEMORY_UTILIZATION=0.70
LLM_VISION_MAX_BATCHED_TOKENS=4096
LLM_VISION_MAX_NUM_SEQS=2
LLM_VISION_SERVED_MODEL_NAME=LipiCore
LLM_A_MAX_CONCURRENCY=12
LLM_C_MAX_CONCURRENCY=4
LLM_VISION_MAX_CONCURRENCY=2
LLM_USER_MAX_CONCURRENCY=1
LLM_ADMIN_MAX_CONCURRENCY=2
LLM_QUEUE_TIMEOUT_SECONDS=120
LLM_QUEUE_STALE_SECONDS=10
LLM_FAST_MAX_TOKENS=512
LLM_DEEP_MAX_TOKENS=768
LLM_VISION_MAX_TOKENS=768
LLM_CONTEXT_WINDOW_TOKENS=8192
LLM_FAST_CONTEXT_WINDOW_TOKENS=8192
LLM_DEEP_CONTEXT_WINDOW_TOKENS=8192
LLM_VISION_CONTEXT_WINDOW_TOKENS=8192

# Open-source OCR
OCR_ENGINE=tesseract
OCR_LANGUAGES=eng+nep
OCR_TESSERACT_CONFIG=--psm 6
OCR_IMAGE_DPI=300
OCR_MAX_PAGES=200
OCR_TEXT_LAYER_REPAIR_MAX_PAGES=500
OCR_VISION_REVIEW_MAX_PAGES=3

# Open-source prompt speech-to-text for chat mic input.
# Use ne/ne-NP for Nepali, not np. The default local provider keeps audio inside
# the bank-controlled deployment and lazily loads the Whisper model on first use.
STT_PROVIDER=local_whisper
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_MODEL_CACHE_DIR=/data/models/hf_cache/faster-whisper
STT_MAX_UPLOAD_BYTES=26214400
STT_TIMEOUT_SECONDS=120
STT_BROWSER_FALLBACK_ENABLED=false
# Optional OpenAI-compatible local STT server:
STT_API_BASE=http://localhost:8010
STT_API_KEY=no-key

# Legacy single-LLM settings kept for compatibility with older scripts.
LLM_MODEL=LipiFast
LLM_API_BASE=http://localhost:8002
LLM_API_KEY=no-key

# Embedding Config
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_CACHE_DIR=/data/models/hf_cache/sentence-transformers
EMBEDDING_NORMALIZE=true
QDRANT_COLLECTION_NAME=bank_documents_bge_m3

# Citation Verification
CITATION_SEMANTIC_VERIFICATION_ENABLED=true
CITATION_SEMANTIC_THRESHOLD=0.70
CITATION_SEMANTIC_MAX_SENTENCES=8
CITATION_SEMANTIC_MAX_SOURCE_SEGMENTS=18
CITATION_NLI_ENABLED=false
CITATION_NLI_THRESHOLD=0.70
CITATION_NLI_MODEL=cross-encoder/nli-deberta-v3-base

# Initial Super Admin
SUPER_ADMIN_EMAIL=admin@lipicore.local
SUPER_ADMIN_PASSWORD=admin-secure-password
